# Phase 2 以降で使用します。実際のキーは .env に書き、コミットしないでください。
# 楽天ウェブサービス https://webservice.rakuten.co.jp/
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# Yahoo!ショッピングAPI https://developer.yahoo.co.jp/
YAHOO_CLIENT_ID=
# Amazon Product Advertising API（アソシエイト審査が必要）
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
# DB（開発: SQLite / 本番: PostgreSQL）
DATABASE_URL=file:./dev.db
# 取得時の User-Agent（連絡先を明記してください）
FETCH_USER_AGENT=price-research-internal/0.1 (contact: you@example.com)
