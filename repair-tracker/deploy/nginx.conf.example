# 自社サーバー(nginx)で配信する場合の例。証明書パスとドメインを自社の値に置き換えること。
# 先に `npm run build` を実行し、dist/ を /var/www/repair-tracker に配置する。
server {
  listen 80;
  server_name repair.example.co.jp;
  return 301 https://$host$request_uri;          # HTTPS強制
}
server {
  listen 443 ssl http2;
  server_name repair.example.co.jp;
  ssl_certificate     /etc/letsencrypt/live/repair.example.co.jp/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/repair.example.co.jp/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  root /var/www/repair-tracker;
  index index.html;

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()" always;

  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
  location / { add_header Cache-Control "no-store"; try_files $uri /index.html; }
}
