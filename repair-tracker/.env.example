# ===== フロントエンド(ビルド時に埋め込まれる。公開されて良い値のみ) =====
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=ここにanonキー(公開可)

# ===== Edge Function のシークレット(Supabase ダッシュボード or `supabase secrets set` で設定。Gitに入れない) =====
# 個人情報暗号化キー: 32バイトをbase64にしたもの。生成: openssl rand -base64 32
# PII_KEYS={"1":"<base64鍵>"}
# PII_KEY_CURRENT=1
# ALLOWED_ORIGIN=https://repair.example.co.jp
# SITE_URL=https://repair.example.co.jp

# ===== バックアップ(scripts/backup.sh 用。サーバー側にのみ置く) =====
# DATABASE_URL=postgresql://postgres:<password>@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# BACKUP_AGE_RECIPIENT=age1xxxxxxxx   # バックアップ暗号化用の公開鍵
