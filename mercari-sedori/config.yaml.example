# コピーして config.yaml として使う: cp config.yaml.example config.yaml
search:
  keywords: ["Nintendo Switch 本体", "AirPods Pro"]
  price_min: 500
  price_max: 10000            # 仕入れ価格の上限(円)
  conditions: ["新品、未使用", "未使用に近い", "目立った傷や汚れなし"]

rate_limit:                    # Playwright版で使用(ステップ3)
  min_interval_sec: 8
  jitter_sec: [2, 6]
  max_searches_per_hour: 30

market:
  window_days: 30
  trim_ratio: 0.10
  min_samples: 5               # これ未満は「信頼度低」

profit:
  fee_rate: 0.10
  packing_cost: 100
  min_net_profit: 1000
  min_margin_rate: 0.15
  margin_basis: sale           # sale=利益/想定売価, cost=利益/仕入れ価格
  require_reliable_market: true
  # 送料(円): セブン-イレブン発送 = らくらくメルカリ便(ヤマト運輸)の料金。
  # 料金改定があり得るため、出品時の最新料金をメルカリのヘルプで確認して更新すること。
  shipping_table:
    nekopos: 210               # ネコポス(A4・厚さ3cm以内・1kg以内)
    compact: 450               # 宅急便コンパクト(専用箱)
    s60: 750
    s80: 850
    s100: 1050
    s120: 1200
    s140: 1450
    s160: 1700
  default_size_class: s80      # 未指定・キーワード不一致時の区分(安全側にしたい場合は s100)
  # タイトルにキーワードを含む場合の区分(上から順に判定)。ジャンル不問の汎用例。
  # 個別指定したい場合は CSV の size_class 列が最優先。該当なしは default_size_class。
  size_class_by_keyword:
    ケーブル: nekopos
    充電器: nekopos
    カード: nekopos
    ステッカー: nekopos
    バッジ: nekopos
    switch: s80
    ゲーム機: s80
    ヘッドホン: s80
    スピーカー: s80
    airpods: compact
    イヤホン: compact
    腕時計: compact
    スニーカー: s100
    炊飯器: s120
    掃除機: s140           # AirPods Pro は箱ごとだと厚みがあるため。ネコポスに入る物は nekopos を指定

exclude:
  keywords_junk: ["ジャンク", "動作未確認", "動作未チェック", "現状品", "部品取り", "難あり"]
  keywords_fake: ["コピー", "レプリカ", "偽物", "偽", "互換品", "ノーブランド", "海外版並行"]
  brands: ["ルイヴィトン", "ヴィトン", "シャネル", "グッチ", "エルメス", "プラダ", "ロレックス", "ルイ・ヴィトン", "louis vuitton", "chanel", "gucci", "hermes", "prada", "rolex"]
  categories: ["チケット", "食品", "化粧品", "コスメ", "医薬品", "サプリ", "金券", "商品券"]
  ng_words: []

notify:
  discord:
    enabled: true              # Webhook URL は .env の DISCORD_WEBHOOK_URL

schedule:
  interval_minutes: 45
  quiet_hours: { start: "00:00", end: "07:00" }   # この間は実行しない

listing:
  model: claude-sonnet-5-5
  markdown_strategy:
    - { after_days: 3, rate: -0.03 }
    - { after_days: 7, rate: -0.05 }

db_path: data/sedori.db
log_dir: logs
